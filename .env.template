# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除。
#
# ParaTranz 个人 Token：https://paratranz.cn/users/my → 「设置」标签页 → API Token
# 注意：Token 账号需要在目标项目里具备「管理员」权限，否则：
#   - 批量导入译文（updateFileTranslation）403
#   - 创建任务 / 术语导入 / 发公告 403
#   - 若项目开启 extra.disableApiEdit，管理员以下成员的 API 写操作会被拒
PTZ_API_TOKEN=

# 项目 ID（也可以写在 config/agent.yaml 的 project.id）
PTZ_PROJECT_ID=6896

# LLM：任意 OpenAI 兼容端点。留空则自动降级为 MockLLM（只用于自测，产出无意义）
PTZ_LLM_API_KEY=
# PTZ_LLM_BASE=https://api.openai.com/v1
# PTZ_LLM_MODEL=gpt-4o-mini

# 可选：覆盖限流与状态目录
# PTZ_API_RATE=420
# PTZ_STATE_DIR=.ptz-state
